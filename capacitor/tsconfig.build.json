{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": [],
    "sourceMap": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts"
  ]
}
